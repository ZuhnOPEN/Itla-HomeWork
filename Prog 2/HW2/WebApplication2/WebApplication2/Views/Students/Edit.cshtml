@{
}

@model WebApplication2.Models.Entity.Students

<h1> Editar estudiante</h1>
@if (Model is null)
{
    <p>El estudiante no fue encontrado.</p>
}
@if (Model is not null){
    <p>Estás editando al estudiante: <strong>@Model.Name @Model.lastName</strong></p>

}

<form method="post">

    <div class="mt-3">
        <label class="form-label">ID</label>
        <input type="text" class="form-control" asp-for="Id" readonly />
    </div>

    <div class="mt-3">
        <label class="form-label">Nombre</label>
        <input type="text" class="form-control" asp-for="Name"  />
    </div>

    <div class="mt-3">
        <label class="form-label">Correo</label>
        <input type="email" class="form-control" asp-for="email" />
    </div>

    <div class="mt-3">
        <label class="form-label">Apellidos</label>
        <input type="text" class="form-control" asp-for="lastName" />
    </div>

    <div class="mt-3">
        <label class="form-label">Descripcion del Estudiante</label>
        <input type="text" class="form-control" asp-for="Description" />
    </div>

    <div class="mt-3">
        <label class="form-label">Numero de telefono.</label>
        <input type="number" class="form-control" asp-for="phone" />
    </div>

    <div class="mt-3">
        <input type="checkbox" class="form-check-input" id="Suscrito" asp-for="News" />
        <label class="form-check-label" fpr="Suscrito">Suscrito</label>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="submit" class="btn btn-dark" asp-action="Delete" asp-controller="Students">Eliminar</button>
    </div>

</form>